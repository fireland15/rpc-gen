// autogenerated
{%- for scalar in scalars %}
type {{ scalar.name }} = {{ scalar.ty }};
{% endfor %}

{%- for type in types %}
type {{ type.name }} = {
{%- for field in type.fields %}
    {{ field.name }}: {{ field.ty }};
{%- endfor %}
}
{% endfor %}

{%- for method in methods %}
export async function {{ method.name }}(
{%- for param in method.parameters -%}
{{ param.name }}: {{ param.ty }}{% if not loop.last %}, {% endif %}
{%- endfor -%}) {%- if method.returns is not null -%}: Promise<{{ method.returns }}> {%- endif %} {
{%- if method.parameters | length > 0 %}
    const payload = {
{%- for param in method.parameters %}
        {{param.name}},
{%- endfor %}
    };

    const headers = new Headers();

{%- if method.serialization_strategy == "json" %}
    const body = JSON.stringify(payload);
    headers.append("Content-Type", "application/json");
{%- endif -%}

{% if method.serialization_strategy == "multipart" %}
    const body = new FormData();
    const fileMap = aliasFiles(payload);
    body.append("payload", JSON.stringify(payload));
    for (const id in fileMap) {
        body.append(id, fileMap[id]);
    }
{%- endif -%}
    
{% endif %}
    const response = await fetch("/{{method.name}}", {
        method: "POST",
{%- if method.parameters | length > 0 %}
        body,
        headers,
{%- endif %}
    });

    return await response.json();
}
{% endfor %}

function aliasFiles(o: any, map: Record<string, File> = {}) {
  let i = 0;
  for (const key in o) {
    if (o[key] instanceof File) {
      const id = `__${i++}`;
      map[id] = o[key];
      o[key] = id;
    } else if (typeof o[key] === "object") {
      aliasFiles(o[key], map);
    }
  }
  return map;
}
