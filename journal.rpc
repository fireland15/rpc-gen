scalar String = string
scalar DateOnly = string
scalar Int = number
scalar Uuid = string

enum Color {
    Red
    Blue
    Green
}

model ChangePasswordResponse {
    name    String
    details String
    date    DateOnly
}

model SigninResponse {
    errors String[]
}

model JournalEntry {
    id Uuid
    title String
    details String?
    status Int
    createdOn DateOnly
    updatedOn DateOnly?
}

mutation Signin(username String, password String) SigninResponse

mutation Signout()

mutation ExtendSession()

mutation ChangePassword(oldPassword String, newPassword String) ChangePasswordResponse

mutation CreateJournalEntry() JournalEntry

model UploadJournalEntryImageRequest {
    journalEntryId Int
}

mutation UploadJournalEntryImage(request UploadJournalEntryImageRequest, image Int)

query GetJournalEntry(id Uuid) JournalEntry