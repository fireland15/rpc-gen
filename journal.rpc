scalar date string
scalar uuid string
scalar int number

model ChangePasswordResponse {
    name    string
    details string 
    date    date   
}

model SigninResponse {
    errors string[]
}

model JournalEntry {
    id uuid
    title string
    details string?
    status int
    createdOn date
    updatedOn date
}

model CreateJournalEntryRequest {
    file Upload
    id int
    type JournalType
}

enum JournalType {
    Apples
    Banans
    YelloCarrots
}

rpc Signin(username string, password string) SigninResponse

rpc ExtendSession() void

rpc Signout() void

rpc ChangePassword(oldPassword string, newPassword string) ChangePasswordResponse

rpc CreateJournalEntry(request CreateJournalEntryRequest) JournalEntry
