scalar date string
scalar uuid string
scalar int number

model ChangePasswordResponse {
    name    string
    details string 
    date    date   
}

model SigninResponse {
    errors string[]
}

model JournalEntry {
    id uuid
    title string
    details string?
    status int
    createdOn date
    updatedOn date
}

model CreateJournalEntryRequest {
    fileUri string
    id int
    type JournalType
}

enum JournalType {
    Apples
    Banans
    YelloCarrots
}

enum CategoryType {
    Income
    Expense
}

mutation Signin(username string, password string) SigninResponse

mutation ExtendSession()

mutation Signout()

mutation ChangePassword(oldPassword string, newPassword string) ChangePasswordResponse

mutation CreateJournalEntry(request CreateJournalEntryRequest) JournalEntry

query GetJournalEntry(id uuid) JournalEntry
