using System.Net.Http;
using System.Net.Http.Json;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.AspNetCore.WebUtilities;

namespace {{ lookup "namespace" }};

public interface IProtocolClient
{
{{- range .Methods }}
    Task{{ template "client_return" . }} {{ toCase .Name "upperCamel" }}Async(
{{- range .Arguments }}
        {{ template "typeRef" .Type }} {{ toCase .Name "camel" }},
{{- end }}
        CancellationToken cancellationToken = default);
{{ end }}
}

public sealed class ProtocolClient : IProtocolClient
{
    private readonly HttpClient _http;

    public ProtocolClient(HttpClient http)
    {
        _http = http;
    }

{{ range .Methods }}
    public async Task{{ template "client_return" . }} {{ toCase .Name "upperCamel" }}Async(
{{- range .Arguments }}
        {{ template "typeRef" .Type }} {{ toCase .Name "camel" }},
{{- end }}
        CancellationToken cancellationToken = default)
    {
{{- if eq .Kind "query" }}

{{- if gt (len .Arguments) 0 }}
        var query = new Dictionary<string, string?>()
        {
{{- range .Arguments }}
            ["{{ .JSONName }}"] = {{ toCase .Name "camel" }}{{ if isOptional .Type }}?.ToString(){{ else }}.ToString(){{ end }},
{{- end }}
        };

        var uri = QueryHelpers.AddQueryString("{{ .Path }}", query);
{{- else }}
        var uri = "{{ .Path }}";
{{- end }}

        var response = await _http.GetAsync(uri, cancellationToken);
{{- else if eq .Kind "mutation" }}
        var payload = new {{ .Name }}Parameters
        {
{{- range .Arguments }}
            {{ toCase .Name "upperCamel" }} = {{ toCase .Name "camel" }},
{{- end }}
        };

        var response = await _http.PostAsJsonAsync(
            "{{ .Path }}",
            payload,
            cancellationToken);
{{- end }}

        response.EnsureSuccessStatusCode();

{{- if ne .ReturnType nil }}
        var result = await response.Content.ReadFromJsonAsync<{{ template "typeRef" .ReturnType }}>(
            cancellationToken: cancellationToken);

        return result!;
{{- end }}
    }

{{ end }}
}
{{ end }}



