public static class ProtocolEndpoints
{
    public static void MapProtocol(this WebApplication app)
    {
{{- range .Methods }}
{{- if eq .Kind "query" }}
        app.MapGet("{{ .Path }}", Handle{{ toCase .Name "upperCamel" }})
{{- end }}
{{- if eq .Kind "mutation" }}
        app.MapPost("{{ .Path }}", Handle{{ toCase .Name "upperCamel" }})
{{- end }}
{{- if hasDecorator . "authorize" }}
            .RequireAuthorization()
{{- end }};
{{- end }}
    }

{{ range .Methods }}
    private static async Task<IResult> Handle{{ toCase .Name "upperCamel" }}(
{{- $length := len .Arguments -}}
{{- if gt $length 0 }}
{{- if eq .Kind "mutation" }}
        [FromBody] {{.Name}}Parameters parameters,
{{- else if eq .Kind "query" }}
{{- range .Arguments }}
        [FromQuery(Name = "{{.JSONName}}")] {{ template "typeRef" .Type }} {{.Name}},
{{- end }}
{{- end }}
{{- end }}
        [FromServices] I{{.Name}}Handler handler,
        CancellationToken cancellationToken)
    {
{{- if ne .ReturnType nil }}
        var result = await handler.HandleAsync({{ template "args_into_interface" . }}cancellationToken);
        return Results.Ok(result);
{{- else }}
        await handler.HandleAsync({{ template "args_into_interface" . }}cancellationToken);
        return Results.NoContent();
{{- end }}
    }
{{ end }}
}
{{ end }}



