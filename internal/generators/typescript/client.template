// autogenerated
// RPC {{.Name}}
// TypeScript client

{{- range .Types}}
{{- if defineType . }}
{{- if eq .Variant "COMPOUND"}}

type {{.Name}} = {
{{- range .Fields}}
    {{.Name}}: {{ formatTypeRef .Type }};
{{- end}}
};
{{- end}}
{{- end}}
{{- end}}

export class JournalRpcClient {
    private readonly baseUrl: string;

    constructor(baseUrl: string) {
        this.baseUrl = baseUrl;
    }


{{- range .Methods }}
{{$method := .}}
    async {{lowerCamelCase .Name}}({{range $index, $element := .Parameters}}{{$element.Name}}: {{formatTypeRef $element.Type}}{{if not (last $index (len $method.Parameters))}}, {{end}}{{end}}): Promise<{{if eq .ReturnType nil}}void{{else}}{{ formatTypeRef .ReturnType }}{{end}}> {
        {{- if len .Parameters -}}
        {{- if eq .SerializationStrategy "default"}}
        const params = {
            {{- range .Parameters}}
            {{.Name}},
            {{- end}}
        };

        const body = JSON.stringify(params);
        {{else}}
        const params = {
            {{- range .Parameters}}
            {{.Name}},
            {{- end}}
        };
        const fileMap = mapFiles(params);
        const body = new FormData();
        body.append("payload", JSON.stringify(params));
        for (const fileId in fileMap) {
            body.append(fileId, fileMap[fileId]);
        }
        {{end}}
        {{- end}}
        const response = await fetch(new URL("{{.Url}}", this.baseUrl), {
            {{- if len .Parameters }}
            body,
            {{- end}}
        });

        if (!response.ok) {
            throw response;
        }

        {{- if not (eq .ReturnType nil)}}

        return await response.json();
        {{- end}}
    }
    {{- end}}

}

function mapFiles(o: any, map: Record<string, File> = {}): Record<string, File> {
    for (const key in o) {
        if (o[key] instanceof File) {
            const fileId = `file${Object.keys(map).length}`;
            map[fileId] = o[key];
            o[key] = fileId;
        } else if (typeof o[key] === "object") {
            mapFiles(o[key], map)
        }
    }
    return map;
}